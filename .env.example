# Job Research Configuration
# Copy this file to .env and fill in your values

# Preferred backend. Every selected source is searched in one run; this decides
# which backend serves a source that more than one could reach. Sources it cannot
# serve fall back to whatever can (free backends first, Claude last).
#   jobspy         Indeed (+ LinkedIn if enabled). No API key.
#   bundesagentur  Federal job board. No API key. Read docs/decisions/001-... first.
#   claude         Anthropic web search. Requires CLAUDE_API_KEY, costs per search.
SCRAPER_BACKEND=claude

# Claude API (required when SCRAPER_BACKEND=claude)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
MAX_JOBS_PER_SEARCH=200

# Interleave results from different job boards (round-robin mix for balanced representation)
INTERLEAVE_SITES=true

# Job Search Parameters
JOB_KEYWORDS=AI Engineer
LOCATION=All of Germany
SENIORITY_LEVELS=All levels
WORK_TYPE=Remote/Hybrid

# Relevance
# Titles containing any of these are dropped outright (comma-separated, whole-word match)
EXCLUDED_KEYWORDS=
# Fraction of a search phrase a title must cover to be kept (0.0-1.0)
RELEVANCE_THRESHOLD=0.6

# Recency — only listings published within N days. Empty means no limit.
# The bundesagentur backend applies this server-side; others filter locally,
# and listings with no parseable date are kept either way.
POSTED_WITHIN_DAYS=

# Salary Range (in EUR)
SALARY_MINIMUM=50000
SALARY_MAXIMUM=200000

# Industries
INDUSTRIES=All

# Job Sources to Search (comma-separated source ids)
# Known ids: indeed, linkedin, stepstone, monster, honeypot, startups, arbeitsagentur
# Ids the active backend cannot reach are skipped. Unknown ids are ignored with a warning.
# Default: indeed,arbeitsagentur
# NOTE: linkedin is off by default (ADR-002). arbeitsagentur is on but uses an
# unofficial endpoint — see docs/decisions/001-bundesagentur-terms-of-use.md.
ENABLED_SOURCES=indeed,arbeitsagentur

# Deprecated: the SEARCH_* booleans still work if ENABLED_SOURCES is unset.

# Output Settings
OUTPUT_DIRECTORY=./data/results
OUTPUT_FORMAT=markdown
GENERATE_SUMMARY=true
GENERATE_SALARY_ANALYSIS=true

# Job store — SQLite file recording every posting seen, so "new since last run"
# has an answer. Delete it to start over; nothing else depends on it.
STORE_PATH=data/jobs.db

# Caching
CACHE_RESULTS=true
CACHE_DURATION_HOURS=24

# Logging
VERBOSE=false

# Email Notifications (Optional)
SEND_EMAIL_NOTIFICATION=false
EMAIL_RECIPIENT=
