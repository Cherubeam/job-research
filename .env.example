# Job Research Configuration
# Copy this file to .env and fill in your values

# Claude API (required for web search scraping)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-6
MAX_JOBS_PER_SEARCH=20

# Job Search Parameters
JOB_KEYWORDS=AI Engineer
LOCATION=All of Germany
SENIORITY_LEVELS=All levels
WORK_TYPE=Remote/Hybrid

# Salary Range (in EUR)
SALARY_MINIMUM=50000
SALARY_MAXIMUM=200000

# Industries
INDUSTRIES=All

# Job Boards to Search
SEARCH_STEPSTONE=true
SEARCH_LINKEDIN=true
SEARCH_INDEED=true
SEARCH_XING=true
SEARCH_HONEYPOT=true
SEARCH_JOBBORSE=true
SEARCH_STARTUPS=true
SEARCH_WELLFOUND=true
SEARCH_REMOTE_ROCKETSHIP=true

# Output Settings
OUTPUT_DIRECTORY=./data/results
OUTPUT_FORMAT=markdown
GENERATE_SUMMARY=true
GENERATE_SALARY_ANALYSIS=true

# Caching
CACHE_RESULTS=true
CACHE_DURATION_HOURS=24

# Logging
VERBOSE=false

# Email Notifications (Optional)
SEND_EMAIL_NOTIFICATION=false
EMAIL_RECIPIENT=
