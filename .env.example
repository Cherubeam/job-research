# Job Research Configuration
# Copy this file to .env and fill in your values

# Scraper backend: "claude" (requires CLAUDE_API_KEY) or "indeed_direct" (no key needed)
SCRAPER_BACKEND=claude

# Claude API (required when SCRAPER_BACKEND=claude)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
MAX_JOBS_PER_SEARCH=20

# Job Search Parameters
JOB_KEYWORDS=AI Engineer
LOCATION=All of Germany
SENIORITY_LEVELS=All levels
WORK_TYPE=Remote/Hybrid

# Salary Range (in EUR)
SALARY_MINIMUM=50000
SALARY_MAXIMUM=200000

# Industries
INDUSTRIES=All

# Job Boards to Search (only Indeed enabled by default for quality)
SEARCH_INDEED=true
SEARCH_STEPSTONE=false
SEARCH_LINKEDIN=false
SEARCH_MONSTER=false
SEARCH_HONEYPOT=false
SEARCH_STARTUPS=false
SEARCH_ARBEITSAGENTUR=false

# Output Settings
OUTPUT_DIRECTORY=./data/results
OUTPUT_FORMAT=markdown
GENERATE_SUMMARY=true
GENERATE_SALARY_ANALYSIS=true

# Caching
CACHE_RESULTS=true
CACHE_DURATION_HOURS=24

# Logging
VERBOSE=false

# Email Notifications (Optional)
SEND_EMAIL_NOTIFICATION=false
EMAIL_RECIPIENT=
